# ============================================================================
# NADC environment variables
# Copy to .env.local for development. NEVER commit real values.
# Each entry says where to get it. Features without credentials return
# honest 503s — nothing is simulated.
# ============================================================================

# --- Core -------------------------------------------------------------------

# Canonical site URL. Production: https://nadc.info
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string.
# Get one from: Supabase (Project Settings → Database → "Connection pooling" URI)
# or Neon (Dashboard → Connection Details, pooled). Use the POOLED string for
# serverless deploys.
DATABASE_URL=postgres://user:password@host:5432/nadc

# Secret for signing admin session JWTs. Generate: openssl rand -hex 32
AUTH_SECRET=

# Salt for one-way IP hashing (abuse triage). Generate: openssl rand -hex 16
IP_HASH_SALT=

# Email address seeded as the first admin (used by `npm run db:seed`).
SEED_ADMIN_EMAIL=

# --- Email (Resend — https://resend.com) -------------------------------------
# Create an API key under Resend → API Keys. Verify the sending domain
# (mail.nadc.info recommended) under Domains, including DKIM/SPF records.
RESEND_API_KEY=
# Sender shown on all mail. The domain must be verified in Resend.
EMAIL_FROM="NADC <alerts@mail.nadc.info>"
# Where admin notifications (new tips, donations, orders) are sent.
ADMIN_NOTIFY_EMAIL=
# Physical postal address — REQUIRED by CAN-SPAM in every marketing email.
# A registered agent or PO box works.
ORG_POSTAL_ADDRESS=

# --- SMS (Twilio — https://twilio.com) ----------------------------------------
# Console → Account Info for SID/token. Create a Messaging Service and
# complete A2P 10DLC brand + campaign registration BEFORE sending (see
# GO_LIVE_CHECKLIST.md). Enable Advanced Opt-Out on the Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Payments (Stripe — https://dashboard.stripe.com) -------------------------
# Developers → API keys. Use test keys until launch.
STRIPE_SECRET_KEY=
# Developers → Webhooks → add endpoint https://nadc.info/api/stripe/webhook
# (events: checkout.session.completed, customer.subscription.deleted),
# then copy its signing secret here.
STRIPE_WEBHOOK_SECRET=

# --- Bot protection (Cloudflare Turnstile — dash.cloudflare.com → Turnstile) --
# Create a widget for nadc.info. Site key is public; secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Civic data (Geocodio — https://dash.geocod.io) ---------------------------
# Free tier: 2,500 lookups/day. Used for address → federal/state reps.
GEOCODIO_API_KEY=

# --- Analytics / Ads attribution ----------------------------------------------
# Reddit conversion pixel. Create in Reddit Ads Manager → Events Manager → Pixel;
# copy the Advertiser/Pixel ID (looks like a2_xxxxxxxx). A live default is baked
# into the code, so this is only needed to override it.
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# Reddit Conversions API (server-side events — ad-blocker-proof, ~15% lift).
# In Events Manager → your pixel → Conversions API: generate an access token,
# and note your Ad Account ID (Reddit Ads → account, format t2_… or numeric).
# Server sends SignUp (email confirm) + Purchase (donation), deduped with the
# pixel. Inert unless BOTH are set.
REDDIT_CONVERSIONS_TOKEN=
REDDIT_AD_ACCOUNT_ID=
# Set to "true" to route events to Events Manager → Test Events (validate the
# payload), then unset to count for real.
REDDIT_CAPI_TEST_MODE=

# --- Maps ---------------------------------------------------------------------
# Default uses OpenFreeMap (free, no key). To switch providers, set a MapLibre
# style URL (e.g. MapTiler: https://api.maptiler.com/maps/streets/style.json?key=...)
# NEXT_PUBLIC_MAP_STYLE_URL=

# --- Print-on-demand (Printful — https://developers.printful.com) -------------
# Optional: automates store fulfillment. Create a token under Settings → API.
PRINTFUL_API_KEY=
